# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Binance API (dùng cho ccxt: load_markets, OHLCV, tickers)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here
# Base URL (mặc định fapi.binance.com; đổi nếu dùng region khác/proxy)
BINANCE_FUTURE_API_BASE_URL=https://fapi.binance.com/

# Rate Limiting Settings (to avoid IP ban)
MAX_CONCURRENT_REQUESTS=5
REQUEST_DELAY_SECONDS=0.5

# Symbol Filtering (Performance Optimization)
# Leave empty or set to 'null' to scan all symbols
# Set a number to limit scanning to top N symbols (sorted by volume)
# Examples: MAX_SYMBOLS_TO_SCAN=50 (top 50), MAX_SYMBOLS_TO_SCAN=100 (top 100)
MAX_SYMBOLS_TO_SCAN=
# MAX_SYMBOLS_TO_SCAN=50

# Symbol sorting: 'volume' (recommended) or 'alphabetical'
# If you get "sort by volume" errors, set to: SYMBOL_SORT_METHOD=alphabetical
SYMBOL_SORT_METHOD=volume
